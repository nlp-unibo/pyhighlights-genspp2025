Bootstrap: docker

# This reproduction has no transformer in it. Both corpora encode with a GRU --
# hidden 8 on Toy, hidden 16 on HateXplain -- so nothing loads a pretrained
# language model, nothing downloads 440 MB of weights, and no dependency
# imposes a torch floor of its own. The base is therefore the stock runtime
# image, chosen as the smallest one that runs the library, and no CUDA version
# is pinned beyond what that image ships.
From: pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

%post
    # No `apt-get`. Every dependency resolves to a wheel, so nothing needs a
    # compiler or a system package, and `%post` under a root-mapped namespace
    # is where an unnecessary root operation turns into a build failure.

    # The image's pip has resolved badly before on these bases; upgrading it
    # first is what makes the resolution correct rather than lucky.
    pip install --no-cache-dir --upgrade pip

    # The library, and nothing of this repository: the reproduction is reached
    # through PYTHONPATH -- see run.sbatch -- so an edit runs without a
    # rebuild, and so the container never holds a second copy of every
    # registration.
    #
    # Pinned exactly, and the floor is a defect rather than a preference.
    # 0.12.0 reports what a run cost -- the `cost_` columns `compare.py`
    # prints a table from. 0.11.0 is the floor below that: it is what
    # `ToyLoader` reads a published corpus with, where earlier versions read it
    # with a `GenSPPToyLoader` that no longer exists and `ToyLoader(url=...)`
    # is an unknown argument, so the failure mode is training on a corpus of
    # the right shape and the wrong content. Below that, 0.9.0 renamed
    # `AnnotationAggregator(rationale=)` to `highlights=` and `RATIONALES` to
    # `HIGHLIGHTS`, which the HateXplain pipeline calls, and carries the GenSPP
    # fixes this reproduction depends on to mean anything -- a candidate's
    # fitness being a property of its chromosome rather than of the
    # initialisation it drew (before it, one chromosome scored 2.8246, 2.4722
    # and 1.0000 in a single run), and one batch order shared across a
    # generation.
    pip install --no-cache-dir "pyhighlights==0.12.0"

    # pyhighlights asks for cinnamon-core `>=2.1.3`. The floor is repeated
    # here because the image does not install this repository and so never
    # reads its `pyproject.toml`. 2.1.3 and not 2.1.2: 2.1.2 forgot every
    # module below a scanned root at the next reset, so a second build
    # resolved a second copy of every class --
    #
    #   TypeError: 'pyhighlights.components.tasks.SPPTask' resolves to
    #   SPPTask, which is not a subclass of SPPTask.
    #
    # -- and it is yanked. An image is built once and run for weeks.
    pip install --no-cache-dir --upgrade "cinnamon-core>=2.1.3,<3"

%environment
    export PYTHONUNBUFFERED=1
    # Slurm gives the job its cores; torch sizing its pool to the whole node
    # would oversubscribe every one of them.
    export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}

%test
    # A build that cannot import the library is a build worth failing here
    # rather than three hours into a queue.
    python -c "import pyhighlights, torch; print(pyhighlights.__version__, torch.__version__)"
