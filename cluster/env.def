Bootstrap: docker

# This reproduction has no transformer in it. Both corpora encode with a GRU,
# hidden 8 on Toy and hidden 16 on HateXplain, so nothing loads a pretrained
# language model and no dependency imposes a torch floor of its own. The base
# is the stock runtime image, the smallest one that runs the library. CUDA
# 12.4 covers the L40S (sm_89) and the H100 (sm_90), which is every GPU
# partition this study is submitted to, and the image carries Python 3.11.
From: pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

%post
    # No `apt-get` here, deliberately. Every dependency resolves to a wheel on
    # PyPI, so nothing needs a compiler or a system package, and `%post` under
    # a root-mapped namespace is exactly where an unnecessary root operation
    # turns into a build failure.

    # The image's pip has resolved badly before, leaving networkx below
    # cinnamon-core's floor and surfacing the mismatch only at import.
    # Upgrading pip first is what makes the resolution correct rather than
    # lucky.
    pip install --no-cache-dir --upgrade pip

    # The library, and nothing of the reproduction: the reproduction is
    # reached through PYTHONPATH instead, as run.sbatch shows, so an edit runs
    # without a rebuild.
    #
    # Each pin is a defect rather than a preference. Commit e48068b loads the
    # embedding table into G-RAT's guider, which read a table of its own
    # before: random on Toy, two rows on HateXplain. Commit bd0ad26 below it regroups a
    # GenSPP candidate's training batches at every epoch, as the release's
    # shuffling loader does, where earlier commits trained every candidate on
    # one batch order. Commit 07cbc16 below it sends a
    # GenSPP worker its corpus and candidates as pickled bytes rather than as
    # files in `/dev/shm`, which a Slurm epilog may delete while the search
    # runs. Commit 3519758 below it writes
    # every finished seed before starting the next and carries the released
    # threshold arm. It scores a search's candidates in spawned worker
    # processes rather than in Python threads, where the interpreter lock and
    # not the cores set the pace of the GenSPP cell. It also lets the GenSPP
    # backbones leave out layer normalisation, as the released encoder does.
    # 0.12.0 below it reports what a run cost under `cost_`,
    # which is the table `compare.py` prints beside Table 1. 0.11.0 below it is what `ToyLoader` reads a
    # published corpus with, where earlier versions read it with a
    # `GenSPPToyLoader` that no longer exists and `ToyLoader(url=...)` is an
    # unknown argument, so the failure mode is training on a corpus of the
    # right shape and the wrong content. 0.9.0 below that renamed
    # `AnnotationAggregator(rationale=)` to `highlights=` and `RATIONALES` to
    # `HIGHLIGHTS`, which the HateXplain pipeline calls, and carries the
    # GenSPP fixes this reproduction depends on to mean anything.
    pip install --no-cache-dir \
        "pyhighlights @ https://github.com/nlp-unibo/pyhighlights/archive/e48068b10c109a649803e09b9e4eb20cb6bd2741.tar.gz"

    # cinnamon-core `>=2.2.1` is pyhighlights' own floor, repeated because the
    # image does not install the reproduction and so never reads its
    # `pyproject.toml`. Spawned GenSPP workers rebuild the registry through
    # `Registry.freeze_runtime`, which earlier versions do not have, so a
    # lower version fails only when the first search opens its workers. An
    # image is built once and run for weeks, so the floor is stated here.
    pip install --no-cache-dir --upgrade "cinnamon-core>=2.2.1,<3"

    # Fail the build here rather than in the first job that imports something.
    # A container that cannot import its own library is not worth four
    # gigabytes.
    python <<'CHECK'
import sys
from importlib.metadata import version

import cinnamon.registry  # noqa: F401  (imported for the failure, not the name)
import pyhighlights  # noqa: F401
import torch  # noqa: F401

packages = ("pyhighlights", "cinnamon-core", "torch")
print(
    f"python {sys.version.split()[0]} | "
    + " | ".join(f"{name} {version(name)}" for name in packages)
)
CHECK

%environment
    export LC_ALL=C

%runscript
    python "$@"
